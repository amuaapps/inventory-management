{
  "name": "donation-product-inventory",
  "version": "1.0.0",
  "description": "Lightweight inventory management system for donation products using Payload CMS",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "dev:setup": "./scripts/start-dev.sh",
    "dev:stop": "./scripts/stop-dev.sh",
    "build": "cross-env NODE_ENV=production next build",
    "serve": "cross-env NODE_ENV=production next start",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:coverage": "jest --coverage",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "clear": "cross-env NODE_ENV=development tsx scripts/clear-products.ts",
    "drop": "cross-env NODE_ENV=development tsx scripts/drop-products-collection.ts",
    "seed": "cross-env NODE_ENV=development tsx scripts/seed-products.ts",
    "reseed": "npm run drop && npm run seed"
  },
  "keywords": [
    "inventory",
    "donation",
    "payload-cms",
    "typescript"
  ],
  "author": "Amua Apps",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.71.1",
    "@payloadcms/next": "3.71.1",
    "@payloadcms/richtext-lexical": "3.71.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "graphql": "^16.12.0",
    "mongodb": "^6.3.0",
    "next": "^16.1.3",
    "payload": "3.71.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
